#!/bin/bash

MONGODB_URI="${MONGODB_URI:-mongodb://mongodb:27017/tfbackend_dev}"
MONGODB_VERSION="${MONGODB_VERSION:-8.2}"

# The BCrypt work factor every stored hash is written at.
# It must stay in step with UserRepository.StoredHashWorkFactor: the application verifies a dummy hash at that
# cost when a username does not exist, so an account created at a different cost is measurably slower to
# reject and reopens the username enumeration oracle for that account alone.
BCRYPT_WORK_FACTOR=10

# Names of the variables that carry a user's values into mongosh.
# Values are passed through the environment and read in JavaScript as process.env, never interpolated into the
# command string, so nothing in a username, a password or a tenant can be read as JavaScript.
MONGOSH_ENV_NAMES=(TFBEADM_USERNAME TFBEADM_PASSWORD_HASH TFBEADM_TENANT)

MONGODB_INDEX_COMMANDS=(
  'db.tf_state.createIndex({"tenant": 1, "name": 1}, {unique: true})'
  'db.tf_state_history.createIndex({"tenant": 1, "name": 1})'
  'db.tf_state_lock.createIndex({"tenant": 1, "name": 1}, {unique: true})'
  'db.user.createIndex({"username": 1}, {unique: true})'
  'db.auth_lockout.createIndex({"username": 1, "remote_address": 1}, {unique: true})'
  'db.auth_lockout.createIndex({"expires_at": 1}, {expireAfterSeconds: 0})'
)

# Renames the pre-existing camelCase createdAt to created_at in tf_state and tf_state_history, the one field
# name the application changed when the schema moved to snake_case.
# $rename only touches a document that still carries createdAt, so this is safe to run more than once, and
# safe to run before or after the application itself is upgraded: a document a newer application has already
# written, or already renamed by an earlier run of this command, is simply not matched.
MONGODB_MIGRATION_COMMANDS=(
  'db.tf_state.updateMany({createdAt: {$exists: true}}, {$rename: {"createdAt": "created_at"}})'
  'db.tf_state_history.updateMany({createdAt: {$exists: true}}, {$rename: {"createdAt": "created_at"}})'
)

# Copies the lock ID of a tf_state_lock document written when the ID was the document's _id into lock_id, the
# field the application reads, so that a lock held across the upgrade can still be released.
# The _id is left as it is, since the application ignores it, and a document that already has lock_id is not
# matched, so this is safe to run more than once.
MONGODB_LOCK_ID_MIGRATION_COMMAND='db.tf_state_lock.updateMany({lock_id: {$exists: false}}, [{$set: {lock_id: "$_id"}}])'

log_info() {
  local message="$1"
  echo -e "$message"
}

log_header() {
  local message="$1"
  echo -e "\033[1;34m$message\033[0m" # blue
}

log_success() {
  local message="$1"
  echo -e "\033[1;32m$message\033[0m" # green
}

log_warn() {
  local message="$1"
  echo -e "\033[1;33mWarn: $message\033[0m" # yello
}

log_error() {
  local message="$1"
  echo -e "\033[1;31mError: $message\033[0m" # red
}

usage() {
  echo -e "\033[1;34mUsage:\033[0m $0 [command] [arguments...]"
  echo -e "\033[1;34mCommands:\033[0m"
  echo "  create-indexes                             : Create indexes in database"
  echo "  migrate-created-at                         : Rename createdAt to created_at in tf_state and tf_state_history, safe to run more than once"
  echo "  migrate-lock-id                            : Copy the lock ID of a tf_state_lock document into lock_id, safe to run more than once"
  echo "  create-user <username> <tenant>            : Create user in database, reading the password from a prompt or standard input"
  echo "  create-user <username> <password> <tenant> : Deprecated, the password is visible in the process list and the shell history"
  echo "  help                                       : Show this help message"
  echo
  echo -e "\033[1;34mExamples:\033[0m"
  echo "  ./scripts/tfbeadm create-user admin dummy"
  echo "  openssl rand -base64 24 | ./scripts/tfbeadm create-user admin dummy"
  echo
  echo "A generated credential is strongly preferred over a chosen one."
  echo "The backend answers a Basic credential on every Terraform request, so a guessable password is the"
  echo "weakest part of the deployment and no rate limit in front of it changes that."
  # echo "  (no arguments)                             : Run in interactive mode"
  exit 1
}

check_command() {
  local cmd=$1
  if command -v "$cmd" &> /dev/null; then
    return 0
  else
    return 1
  fi
}

check_htpasswd() {
  if ! command -v htpasswd &> /dev/null; then
      log_error "htpasswd is not installed."
      log_info "Please install apache2-utils (on Debian/Ubuntu) or httpd-tools (on CentOS/RHEL)."
      log_info "Installation commands:"
      log_info "  Debian/Ubuntu: sudo apt-get install apache2-utils"
      log_info "  CentOS/RHEL: sudo yum install httpd-tools"
      exit 1
  fi
}

# Fills the named array with "-e NAME" flags for the variables that are set, so that docker forwards them
# without the values ever appearing in an argument.
mongosh_env_flags() {
  local -n target=$1
  local name
  for name in "${MONGOSH_ENV_NAMES[@]}"; do
    if [[ -v $name ]]; then
      target+=(-e "$name")
    fi
  done
}

# Fills the named array with "NAME=value" assignments for `env`, used where the command cannot inherit the
# caller's environment.
mongosh_env_assignments() {
  local -n target=$1
  local name
  for name in "${MONGOSH_ENV_NAMES[@]}"; do
    if [[ -v $name ]]; then
      target+=("$name=${!name}")
    fi
  done
}

execute_mongosh() {
  local mongodb_cmd="$1"
  if [[ -v MONGODB_KUBEDEPLOYNAME ]]; then
    execute_mongosh_kubectl "$mongodb_cmd" || return 1
  elif check_command "mongosh"; then
    execute_mongosh_package "$mongodb_cmd" || return 1
  else
    if check_command "docker"; then
      if [[ -n "$MONGODB_CONTAINERNAME" ]]; then
        execute_mongosh_docker_link "$mongodb_cmd" || return 1
      else
        execute_mongosh_docker "$mongodb_cmd" || return 1
      fi
    else
      echo "Error: Neither mongosh nor Docker is installed. Please install one to proceed."
      return 1
    fi
  fi
}

execute_mongosh_kubectl() {
  local mongodb_cmd="$1"
  log_info "Executing MongoDB command in a Kubernetes pod shell: $mongodb_cmd"
  local env_assignments=()
  mongosh_env_assignments env_assignments
  if output=$(kubectl exec "$MONGODB_KUBEDEPLOYNAME" -n tfbackend -- env "${env_assignments[@]}" mongosh "$MONGODB_URI" --eval "$mongodb_cmd" 2>&1); then
    log_info "Output:\n$output"
  else
    log_warn "$output"
    return 1
  fi
}

execute_mongosh_package() {
  local mongodb_cmd="$1"
  log_info "Executing MongoDB command in the shell: $mongodb_cmd"
  if output=$(mongosh "$MONGODB_URI" --eval "$mongodb_cmd" 2>&1); then
    log_info "Output:\n$output"
  else
    log_warn "$output"
    return 1
  fi
}

execute_mongosh_docker() {
  local mongodb_cmd="$1"
  log_info "Executing MongoDB command in a container: $mongodb_cmd"
  local env_flags=()
  mongosh_env_flags env_flags
  if output=$(docker run --rm "${env_flags[@]}" "mongo:$MONGODB_VERSION" mongosh "$MONGODB_URI" --eval "$mongodb_cmd" 2>&1); then
    log_info "Output:\n$output"
  else
    log_warn "$output"
    return 1
  fi
}

execute_mongosh_docker_link() {
  local mongodb_cmd="$1"
  log_info "Executing MongoDB command in a container with a link: $mongodb_cmd"
  local env_flags=()
  mongosh_env_flags env_flags
  if output=$(docker run --rm --link "$MONGODB_CONTAINERNAME" --network "$MONGODB_CONTAINERNETWORK" "${env_flags[@]}" "mongo:$MONGODB_VERSION" mongosh "$MONGODB_URI" --quiet --eval "$mongodb_cmd" 2>&1); then
    log_info "Output:\n$output"
  else
    log_warn "$output"
    return 1
  fi
}

create_indexes() {
  local status=0
  log_header "Creating predefined MongoDB indexes"
  for cmd in "${MONGODB_INDEX_COMMANDS[@]}"; do
    execute_mongosh "$cmd" || status=1
  done
  if [ $status -eq 0 ]; then
    log_success "All indexes created successfully"
  else
    log_error "One or more index creations failed"
  fi
  return $status
}

migrate_created_at() {
  local status=0
  log_header "Renaming createdAt to created_at in tf_state and tf_state_history"
  for cmd in "${MONGODB_MIGRATION_COMMANDS[@]}"; do
    execute_mongosh "$cmd" || status=1
  done
  if [ $status -eq 0 ]; then
    log_success "Migration complete"
  else
    log_error "One or more renames failed"
  fi
  return $status
}

migrate_lock_id() {
  log_header "Copying lock IDs into lock_id in tf_state_lock"
  if execute_mongosh "$MONGODB_LOCK_ID_MIGRATION_COMMAND"; then
    log_success "Migration complete"
  else
    log_error "The copy failed"
    return 1
  fi
}

# Reads a password without echoing it and without it ever becoming an argument.
# Prompts on a terminal, and otherwise takes one line from standard input so that the command composes with a
# generator, for example `openssl rand -base64 24 | tfbeadm create-user admin dummy`.
read_password() {
  local prompt_target=$1
  local value
  if [ -t 0 ]; then
    read -rsp "Password: " value < /dev/tty
    echo >&2
  else
    IFS= read -r value || true
  fi

  if [ -z "$value" ]; then
    log_error "No password provided"
    exit 1
  fi

  printf -v "$prompt_target" '%s' "$value"
}

create_user() {
  local username=$1
  local password=$2
  local tenant=$3
  log_header "Creating user"

  local hash
  if ! hash=$(printf '%s' "$password" | htpasswd -niBC "$BCRYPT_WORK_FACTOR" "" | tr -d ':\n') || [ -z "$hash" ]; then
    log_error "Failed to generate BCrypt hash"
    exit 1
  fi

  # The values travel through the environment and are read as process.env, never interpolated into the command
  # string. That is what makes a quote in a password or a username harmless: nothing the caller supplies is
  # ever parsed as JavaScript, and nothing is quoted through two shells by hand.
  local creation_command='db.user.insertOne({
    username: process.env.TFBEADM_USERNAME,
    password_hash: process.env.TFBEADM_PASSWORD_HASH,
    tenant: process.env.TFBEADM_TENANT
})'

  export TFBEADM_USERNAME="$username"
  export TFBEADM_PASSWORD_HASH="$hash"
  export TFBEADM_TENANT="$tenant"

  local status=0
  execute_mongosh "$creation_command" || status=1

  unset TFBEADM_USERNAME TFBEADM_PASSWORD_HASH TFBEADM_TENANT

  if [ $status -eq 0 ]; then
    log_success "User created successfully"
  else
    log_error "User creation failed"
    exit 1
  fi
}

# checks for command-line arguments
if [ $# -gt 0 ]; then
  case "$1" in
    "create-indexes")
      create_indexes
      exit $?
      ;;
    "migrate-created-at")
      migrate_created_at
      exit $?
      ;;
    "migrate-lock-id")
      migrate_lock_id
      exit $?
      ;;
    "create-user")
      check_htpasswd
      shift
      if [ -z "$1" ]; then
        log_error "No username provided"
        usage
      fi
      username="$1"
      shift
      if [ -z "$1" ]; then
        log_error "No tenant provided"
        usage
      fi

      # Two forms are accepted, told apart by how many arguments are left.
      # <username> <tenant> reads the password from a prompt or standard input, and is the one to use.
      # <username> <password> <tenant> is kept so that existing scripts and the compose dbinit service keep
      # working, and warns, because an argument is visible in the process list to every user on the host and
      # is written to the shell history file.
      if [ -n "$2" ]; then
        password="$1"
        tenant="$2"
        log_warn "Passing the password as an argument exposes it in the process list and the shell history."
        log_info "Prefer: $0 create-user <username> <tenant>"
      else
        tenant="$1"
        read_password password
      fi

      create_user "$username" "$password" "$tenant"
      exit $?
      ;;
    "help")
      usage
      ;;
    *)
      log_error "Invalid command: $1"
      usage
      ;;
  esac
fi

usage
